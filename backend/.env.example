# Copia este archivo a ".env" y rellena tu clave de Gemini.
GEMINI_API_KEY=tu_api_key_aqui

# Orígenes permitidos por CORS (separados por comas).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ruta del archivo SQLite. Por defecto backend/data/autorrss.db
# DATABASE_PATH=./data/autorrss.db
